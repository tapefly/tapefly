{
  "name": "tapefly",
  "version": "0.4.0",
  "private": true,
  "description": "TAPEFLY — today's fly, the same one for everyone. Its whole brain is 50 NAND gates, and every tick is sealed.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "content:check": "tsx scripts/content-consistency.ts",
    "workshop:check": "tsx scripts/workshop-check.ts",
    "evo:check": "tsx scripts/evo-check.ts",
    "evo:histo": "tsx scripts/evo-histo.ts",
    "replay": "tsx scripts/replay.ts",
    "lineage": "tsx scripts/lineage.ts",
    "record": "tsx scripts/make-record.ts",
    "verify-record": "tsx scripts/verify-record.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "verify:onchain": "npm run tapeout -- verify",
    "judge:check": "npm run content:check && npm run typecheck && npm test && npm run lineage -- --check && npm run board -- --check && npm run anchor -- --check && npm run arena:ghosts -- --check && npm run build",
    "check": "npm run content:check && npm run typecheck && npm test && npm run lineage -- --check && npm run board -- --check && npm run anchor -- --check && npm run arena:ghosts -- --check && npm run tapeout -- bytes > /dev/null && npm run build",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "board": "tsx scripts/board.ts",
    "tapeout": "tsx scripts/tapeout.ts",
    "anchor": "tsx scripts/anchor.ts",
    "arena:ghosts": "tsx scripts/arena-ghosts.ts",
    "agent:demo": "tsx scripts/agent-demo.ts",
    "agent:workshop": "tsx scripts/workshop-agent-demo.ts",
    "agent:proof": "tsx scripts/workshop-agent-proof.ts",
    "xlayer:processor:preflight": "tsx scripts/xlayer-processor-preflight.ts",
    "backup:workshop": "tsx scripts/backup-workshop.ts",
    "check:web": "tsx scripts/check-web.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "26.6.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
